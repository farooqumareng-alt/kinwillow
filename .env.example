# KinWillow app environment (set in Vercel project settings for production)
# Supabase project: kinwillow (gelitbdxtqexwspjfotg)
NEXT_PUBLIC_SUPABASE_URL=https://gelitbdxtqexwspjfotg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public base URL used for links in emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.kinwillow.com

# Server-only:
SUPABASE_URL=https://gelitbdxtqexwspjfotg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
NOTIFY_EMAIL=

# Field encryption master key: 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it makes every encrypted field and released package unreadable.
KINWILLOW_MASTER_KEY=

# Protects the scheduled job at /api/cron/disclosure (automatic emergency
# release and owner reminders). Vercel sends it as "Authorization: Bearer …".
# Without it the job refuses to run and nothing is ever auto-released.
CRON_SECRET=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_FAMILY_PARENTS=
# Optional: a Stripe coupon id applied at first checkout for accounts that
# signed up through a partner's referral link. Leave empty for no discount.
STRIPE_PARTNER_COUPON=

# Android app (Play Store). Links the app to this site so it opens full-screen.
# The fingerprint comes from Play Console → Setup → App signing.
ANDROID_PACKAGE_NAME=com.kinwillow.app
ANDROID_CERT_SHA256=
